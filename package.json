{
  "dependencies": {
    "express": "^4.21.2"
  },
  "description": "A tiny docs-grounded Q&A app plus the evaluation harness that answers one question: did the AI get worse?",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "promptfoo": "^0.125.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "rag-eval-harness",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "eval": "node evals/run-variant.mjs v1",
    "eval:broken": "node evals/run-variant.mjs broken",
    "eval:live": "node evals/run-variant.mjs v1 --live",
    "eval:v2": "node evals/run-variant.mjs v2",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "version": "0.1.0"
}